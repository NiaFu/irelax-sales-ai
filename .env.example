# Backend database
DATABASE_URL=jdbc:postgresql://localhost:5432/irelax_sales_ai
DATABASE_USERNAME=irelax
DATABASE_PASSWORD=irelax

# Authentication. Keep false for local development.
AUTH_ENABLED=false
DEV_OWNER_ID=nia
# For Supabase JWT validation when AUTH_ENABLED=true, for example:
# SUPABASE_ISSUER_URI=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_ISSUER_URI=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_OWNER_ID=nia
TWILIO_MOCK_ENABLED=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:8080
# Optional JWT for a protected backend during development.
EXPO_PUBLIC_API_BEARER_TOKEN=
